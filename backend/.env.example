SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=kriyo.example.com
CSRF_TRUSTED_ORIGINS=https://kriyo.example.com

# Production hardening -- only turn these on once a real domain + TLS
# certificate are live in front of nginx (see deploy/README.md). Left unset,
# they default to the opposite of DEBUG.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Supabase Postgres, direct connection (session pooler recommended for long-lived
# connections from a single backend process) — Supabase is used here only as a
# hosted Postgres instance, no Supabase SDK/auth involved.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres
